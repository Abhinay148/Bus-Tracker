generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
}

model Bus {
  id          Int      @id @default(autoincrement())
  busNumber   String   @unique
  route       String
  latitude    Float?
  longitude   Float?
  status      String   @default("ACTIVE")
  updatedAt   DateTime @updatedAt
}